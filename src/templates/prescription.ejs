<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      line-height: 1.6;
      color: #2c3e50;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 650px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
      text-align: center;
      padding: 50px 40px;
      margin-bottom: 0;
      position: relative;
      overflow: hidden;
    }

    .header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 300px;
      height: 300px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
    }

    .header h1 {
      color: #ffffff;
      font-size: 32px;
      margin-bottom: 8px;
      font-weight: 700;
      position: relative;
      z-index: 2;
    }

    .header p {
      color: #e0e7ff;
      font-size: 13px;
      font-weight: 300;
      position: relative;
      z-index: 2;
      letter-spacing: 0.5px;
    }

    .greeting {
      color: #2c3e50;
      font-size: 15px;
      margin-bottom: 30px;
      padding: 35px 40px 0;
    }

    .greeting strong {
      font-weight: 600;
    }

    .greeting p {
      line-height: 1.7;
    }

    .greeting p:first-of-type {
      margin-bottom: 12px;
    }

    .content {
      margin-bottom: 30px;
      padding: 0 40px;
    }

    .section {
      margin-bottom: 30px;
    }

    .section-title {
      color: #1e3c72;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 3px solid #2a5298;
      display: inline-block;
      letter-spacing: 0.8px;
    }

    .info-grid {
      background: linear-gradient(135deg, #f5f7fa 0%, #f0f3f7 100%);
      padding: 22px;
      border-radius: 8px;
      border-left: 4px solid #2a5298;
    }

    .info-row {
      margin-bottom: 12px;
      font-size: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .info-row:last-child {
      margin-bottom: 0;
    }

    .info-row strong {
      color: #2c3e50;
      font-weight: 600;
      min-width: 140px;
    }

    .info-row span {
      color: #555;
      text-align: right;
      flex: 1;
    }

    .instructions {
      background: linear-gradient(135deg, #e8f4f8 0%, #d4e9f0 100%);
      padding: 25px;
      border-radius: 8px;
      border-left: 5px solid #0084ff;
      margin: 20px 0;
    }

    .instructions-title {
      color: #0084ff;
      font-weight: 700;
      font-size: 12px;
      text-transform: uppercase;
      margin-bottom: 14px;
      letter-spacing: 0.5px;
    }

    .instructions-content {
      color: #2c3e50;
      font-size: 14px;
      line-height: 1.9;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .pdf-section {
      background: linear-gradient(135deg, #fff8e1 0%, #ffe0b2 100%);
      padding: 28px;
      border-radius: 8px;
      border-left: 5px solid #ff9800;
      margin: 25px 0;
      text-align: center;
    }

    .pdf-section p {
      margin: 0;
    }

    .pdf-section p:first-of-type {
      color: #e65100;
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .pdf-section p:last-of-type {
      font-size: 12px;
      color: #666;
    }

    .pdf-link {
      display: inline-block;
      background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
      color: #ffffff;
      padding: 12px 32px;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 700;
      font-size: 13px;
      margin-top: 12px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(255, 152, 0, 0.3);
      letter-spacing: 0.3px;
    }

    .pdf-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 152, 0, 0.4);
    }

    .warning-box {
      background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
      padding: 20px;
      border-radius: 8px;
      border-left: 5px solid #d32f2f;
    }

    .warning-box p {
      color: #c62828;
      font-size: 13px;
      line-height: 1.8;
      margin: 0;
    }

    .warning-box strong {
      font-weight: 700;
    }

    .footer {
      background-color: #f5f7fa;
      border-top: 1px solid #e8eef5;
      padding: 30px 40px;
      text-align: center;
      color: #7f8c8d;
      font-size: 12px;
      line-height: 1.8;
    }

    .footer p {
      margin-bottom: 8px;
    }

    .footer p:last-of-type {
      margin-bottom: 0;
      font-size: 11px;
      color: #95a5a6;
      margin-top: 12px;
    }

    .footer strong {
      color: #2c3e50;
      font-weight: 700;
    }

    @media (max-width: 600px) {
      .container {
        border-radius: 0;
      }

      .header {
        padding: 40px 20px;
      }

      .content,
      .greeting,
      .footer {
        padding-left: 20px;
        padding-right: 20px;
      }

      .info-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .info-row span {
        text-align: left;
        margin-top: 4px;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>Prescription Document</h1>
      <p>PH Healthcare Services</p>
    </div>

    <!-- Greeting -->
    <div class="greeting">
      <p>Dear <strong>
          <%= patientName %>
        </strong>,</p>
      <p style="margin-top: 10px;">
        Your prescription has been issued. Please review the details below.
      </p>
    </div>

    <!-- Content -->
    <div class="content">
      <!-- Doctor Information -->
      <div class="section">
        <div class="section-title">👨‍⚕️ Doctor Information</div>
        <div class="info-grid">
          <div class="info-row">
            <strong>Doctor Name:</strong>
            <span>
              <%= doctorName %>
            </span>
          </div>
          <div class="info-row">
            <strong>Specialization:</strong>
            <span>
              <%= specialization %>
            </span>
          </div>
        </div>
      </div>

      <!-- Prescription Details -->
      <div class="section">
        <div class="section-title">📝 Prescription Details</div>
        <div class="info-grid">
          <div class="info-row">
            <strong>Prescription ID:</strong>
            <span>
              <%= prescriptionId %>
            </span>
          </div>
          <div class="info-row">
            <strong>Appointment Date:</strong>
            <span>
              <%= appointmentDate %>
            </span>
          </div>
          <div class="info-row">
            <strong>Issued Date:</strong>
            <span>
              <%= issuedDate %>
            </span>
          </div>
          <% if (followUpDate) { %>
            <div class="info-row">
              <strong>Follow-up Date:</strong>
              <span>
                <%= followUpDate %>
              </span>
            </div>
            <% } %>
        </div>
      </div>

      <!-- Instructions -->
      <div class="section">
        <div class="instructions">
          <div class="instructions-title">💊 Instructions & Medications</div>
          <div class="instructions-content">
            <%= instructions %>
          </div>
        </div>
      </div>

      <!-- PDF Download -->
      <div class="pdf-section">
        <p>📥 <strong>Download Your Prescription PDF</strong></p>
        <p style="font-size: 12px; color: #666; margin-top: 10px;">
          Your prescription PDF has been attached to this email. You can also download it using the link below.
        </p>
        <% if (pdfUrl) { %>
          <a href="<%= pdfUrl %>?fl_attachment" class="pdf-link" target="_blank" download="prescription.pdf">Download
            PDF</a>
          <% } %>
      </div>

      <!-- Important Notes -->
      <div class="warning-box">
        <p>
          <strong>⚠️ Important:</strong> Please follow all instructions provided by your doctor carefully. If you
          have any questions or concerns, please contact your healthcare provider immediately.
        </p>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>
        This is an automated email from PH Healthcare Services. Please do not reply to this email. If you have any
        questions, contact our support team.
      </p>
      <p style="margin-top: 10px;">For more information, visit: <strong>https://ph-healthcare.com</strong></p>
    </div>
  </div>
</body>

</html>